[Unit]
Description=PowerJoular service
Documentation=https://github.com/joular/powerjoular

[Service]
Type=simple
Restart=always
RestartSec=30

# Reading the energy counters of the hardware needs root
User=root

# systemd makes the folder on start and removes it on stop, owned by root and readable by all
RuntimeDirectory=powerjoular
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/powerjoular -o /run/powerjoular/powerjoular-service.csv

# The service only reads the energy counters and the CPU load and writes one file in its own folder; everything else is taken away
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Nothing here needs a capability of its own: the files it reads are root's own
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
