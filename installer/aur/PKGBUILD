# Maintainer: Adel Noureddine <adel.noureddine@outlook.com>
pkgname=powerjoular
pkgver=2.0.0
pkgrel=1
pkgdesc="PowerJoular allows monitoring power consumption of multiple platforms and processes."
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/joular/powerjoular"
license=('GPL-3.0-only')
makedepends=('gcc-ada' 'gprbuild' 'alire')
# Release tags carry no "v" prefix, so the tarball unpacks into powerjoular-$pkgver
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
# Replace with the real checksum once the tag is pushed: run updpkgsums in this folder
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    alr --non-interactive build
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 bin/powerjoular "$pkgdir/usr/bin/powerjoular"
    install -Dm644 systemd/powerjoular.service "$pkgdir/etc/systemd/system/powerjoular.service"
}
