# Maintainer: Adel Noureddine <adel.noureddine@outlook.com>
pkgname=powerjoular
pkgver=2.0.0
pkgrel=1
# The release tags of the two libraries, which have to satisfy the constraints of alire.toml
_joularcore_tag=0.0.6
_cpuload_tag=0.0.6
pkgdesc="Monitor the power consumption of platforms, processes and applications"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/joular/powerjoular"
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('gcc-ada' 'gprbuild' 'git')

source=("$pkgname::git+$url.git#tag=$pkgver"
        "joularcore::git+https://github.com/joular/joularcore.git#tag=$_joularcore_tag"
        "cpuload::git+https://github.com/joular/cpuload.git#tag=$_cpuload_tag")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

build() {
    cd "$srcdir/$pkgname"
    # Each library is checked out into a folder named after it, and is found through the project search path
    # PJ_OS is given, as gprconfig doesn't know the target name of every Arch GCC (armv7h) and the libraries then stop
    gprbuild -P powerjoular.gpr -p \
        -aP"$srcdir/joularcore" \
        -aP"$srcdir/cpuload" \
        -XPJ_OS=linux
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 bin/powerjoular "$pkgdir/usr/bin/powerjoular"
    install -Dm644 systemd/powerjoular.service "$pkgdir/usr/lib/systemd/system/powerjoular.service"
}
