with "joularcore.gpr";
with "cpuload.gpr";

project Powerjoular is

    -- Built for the same OS as CPU Load, so the program and its libraries always agree
    -- Override with: gprbuild -XPJ_OS=windows
    type OS_Platform is ("linux", "windows", "macos");
    PJ_OS : OS_Platform := CpuLoad.PJ_OS;

    -- Portable code is in src, the body of PowerJoular.Platform for one OS in its own folder
    -- src/posix holds what Linux and macOS share
    case PJ_OS is
        when "linux" =>
            for Source_Dirs use ("src", "src/posix", "src/linux");
        when "windows" =>
            for Source_Dirs use ("src", "src/windows");
        when "macos" =>
            for Source_Dirs use ("src", "src/posix", "src/macos");
    end case;

    -- default: Ada runtime and libgcc static, libc shared (what the released packages use)
    -- full: fully static; on Linux the GPU readings are lost (no dlopen)
    -- macOS has no static libc, so full does nothing there
    type Linking_Kind is ("default", "full");
    Linking : Linking_Kind := external ("POWERJOULAR_LINKING", "default");

    Link_Switches := ("-static-libgcc");

    case Linking is
        when "default" =>
            null;
        when "full" =>
            case PJ_OS is
                when "macos" =>
                    null;
                when others =>
                    Link_Switches := ("-static");
            end case;
    end case;

    for Languages use ("Ada");
    for Object_Dir use "obj";
    for Exec_Dir use "bin";
    for Create_Missing_Dirs use "True";
    for Main use ("powerjoular_main.adb");

    package Builder is
        for Executable ("powerjoular_main.adb") use "powerjoular";
    end Builder;

    package Compiler is
        for Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa");
    end Compiler;

    package Binder is
        -- Carry the Ada runtime inside the binary, so it runs on a machine that has no GNAT installed
        for Switches ("Ada") use ("-static");
    end Binder;

    package Linker is
        for Switches ("Ada") use Link_Switches;
    end Linker;

end Powerjoular;
